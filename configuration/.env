# Default Template:
    # Matches the README.md guide. Adjustments to model locations is fairgame.

OPENBLAS_NUM_THREADS = 1
no_proxy = localhost, 127.0.0.1, ::1

# You can change the location of the model, etc. by changing here
weight_root = /home/arelius/rvc-models/assets/weights
weight_uvr5_root = /home/arelius/rvc-models/assets/uvr5_weights
index_root = results
outside_index_root = /home/arelius/rvc-models/assets/indices
