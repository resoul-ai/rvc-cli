# You can change the location of the model, etc. by changing here
model_name = clark.pth

# additions to training api config
input_root = data/clips
exp_dir = /home/arelius/rvc-models/results/clark
root_dir = rvc-models
rmvpe_is_half = False
pretrained_G = /home/arelius/rvc-models/assets/pretrained_v2/f0G40k.pth
pretrained_D = /home/arelius/rvc-models/assets/pretrained_v2/f0D40k.pth
hubert_base_path = /home/arelius/rvc-models/assets/hubert/hubert_base.pt
